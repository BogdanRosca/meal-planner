{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(find:*)",
      "Bash(npm run:*)",
      "Bash(npx eslint:*)",
      "Bash(npm test:*)",
      "Bash(git add:*)",
      "Bash(source:*)"
    ],
    "deny": ["Read(**/.env*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ./frontend && npm run format 2>/dev/null || true",
            "async": true,
            "statusMessage": "Formatting frontend code"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ./backend && flake8 2>/dev/null || true",
            "async": true,
            "statusMessage": "Linting backend code"
          }
        ]
      }
    ]
  }
}
