# Database configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Recipe import from YouTube (server-side only, never exposed to the frontend)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional, defaults to claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: Netscape cookies.txt exported from a logged-in browser, used by yt-dlp
# when Instagram requires a session (rate-limited or login-gated reels)
INSTAGRAM_COOKIES_FILE=
